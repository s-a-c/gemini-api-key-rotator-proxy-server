<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.antigravity.proxy</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/uv</string>
        <string>run</string>
        <string>uvicorn</string>
