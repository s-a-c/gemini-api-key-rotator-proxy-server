# Antigravity Proxy — Environment Variables
# Copy to .env and fill in your values.
# The .env file is loaded automatically at startup (requires python-dotenv).
# Values set here are overridden by shell environment variables and launchd
# EnvironmentVariables in the plist.

# ── Telegram Bot (optional) ───────────────────────────────────────────────────
# Leave both empty to disable Telegram integration entirely.

# Bot token from @BotFather
TELEGRAM_TOKEN=

# Your personal or group chat ID (use @userinfobot to find it)
TELEGRAM_CHAT_ID=

# ── Admin Token ───────────────────────────────────────────────────────────────
# Used to authenticate requests to internal endpoints from non-localhost clients.
# Change this to a strong random value if the proxy is exposed on the network.
# Default: changeme_local_only (allows unauthenticated access from 127.0.0.1)

ADMIN_TOKEN=changeme_local_only
